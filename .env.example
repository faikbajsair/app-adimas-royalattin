# 1. Kredensial Database Google Sheets (Pilih salah satu)
# Opsi A (Direkomendasikan): Masukkan seluruh isi kunci JSON dari Google Service Account Anda (satu baris stringified JSON)
GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n", "client_email": "...", ...}'

# Opsi B: Memasukkan email dan private key secara terpisah
GOOGLE_CLIENT_EMAIL="nama-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KUNCI_PRIVATE_KEY_DISINI\n-----END PRIVATE KEY-----"

# 2. ID Spreadsheet Database Utama
# Buka spreadsheet Anda, ID terletak di URL: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SPREADSHEET_ID="1_masukkan_spreadsheet_id_adimas_disini"

# 3. Kredensial Sesi (Keamanan Login Cookie)
# Tuliskan string acak minimal 32 karakter untuk hashing token sesi
SESSION_SECRET="adimas-school-management-premium-jwt-session-secret-key-64chars"
